{
  "name": "@j4k-oss/worktree-add",
  "version": "1.0.0",
  "description": "Create a Git worktree next to your current repo for a branch, copy useful local files, install deps, and open it in your apps.",
  "keywords": [
    "cli",
    "development",
    "git",
    "git-worktree",
    "workflow",
    "worktree"
  ],
  "homepage": "https://code.j4k.dev/j4k-oss/worktree-add#readme",
  "bugs": {
    "url": "https://code.j4k.dev/j4k-oss/worktree-add/issues"
  },
  "license": "MIT",
  "author": "Łukasz Jerciński",
  "repository": {
    "type": "git",
    "url": "https://code.j4k.dev/j4k-oss/worktree-add.git"
  },
  "bin": {
    "worktree-add": "bin/worktree-add"
  },
  "files": [
    "bin/",
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "publishConfig": {
    "registry": "https://code.j4k.dev/api/packages/j4k-oss/npm/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:dts": "node scripts/check-dts.ts",
    "clean": "rm -rf dist *.tsbuildinfo",
    "format": "oxfmt --config .oxfmtrc.json .",
    "format:check": "oxfmt --check --config .oxfmtrc.json .",
    "fta": "fta-check",
    "knip": "knip",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives .",
    "prepack": "pnpm run rebuild",
    "prepare": "if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then hooks_path=$(git config --local --get-all core.hooksPath 2>/dev/null && echo .) && [ \"$hooks_path\" = \"$(echo .githooks; echo .)\" ] || git config core.hooksPath .githooks; fi",
    "rebuild": "pnpm run clean && pnpm run build",
    "start": "pnpm run rebuild && node bin/worktree-add",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -b tsconfig.check.json tsconfig.test.json tsconfig.scripts.json tsconfig.app.json tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^15.0.0",
    "commander": "^15.0.0",
    "open": "^11.0.0",
    "package-manager-detector": "^1.6.0",
    "trash": "^10.1.1"
  },
  "devDependencies": {
    "@j4k-oss/fta-check": "^1.5.11",
    "@j4k/oxlint-config": "^2.14.2",
    "@j4k/semantic-release-forgejo": "^1.2.4",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.8",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "fta-cli": "^3.0.0",
    "knip": "^6.16.1",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "semantic-release": "^25.0.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "pnpm@12.11.2",
  "j4k": {
    "alignDtsCheck": true,
    "alignModuleContract": "esm-only"
  }
}
